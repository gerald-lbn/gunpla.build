{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "@generated/*": ["../.adonisjs/client/*"],
      "#models/*": ["../app/models/*"],
      "#transformers/*": ["../app/transformers/*"],
      "#app/*": ["../app/*"],
      "#kits/*": ["../app/kits/*"],
      "#auth/*": ["../app/auth/*"],
      "#feed/*": ["../app/feed/*"],
      "#profile/*": ["../app/profile/*"],
      "#core/*": ["../app/core/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../.adonisjs/client/**/*.ts",
    "../.adonisjs/server/**/*.ts"
  ]
}
