# Node
TZ=UTC
PORT=3333
HOST=127.0.0.1
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# AtProto
PUBLIC_URL=http://$HOST:$PORT/
# ATPROTO_OAUTH_CLIENT_ID=

# Jetstream & Internal
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Cloudflare Tunnel
# CLOUDFLARE_TUNNEL_TOKEN=