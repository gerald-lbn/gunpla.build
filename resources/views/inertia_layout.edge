<!DOCTYPE html>
<html lang="en" data-theme="{{ request.plainCookie('app_theme', { defaultValue: 'dark', encoded: false }) }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A shelf for your Gunpla builds, stored in your own AT Protocol repository. Log kits by grade and scale, add photos, and browse what the community is building." />
    <meta name="theme-color" content="#000000" />
    <title data-inertia>gunpla.build</title>

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
